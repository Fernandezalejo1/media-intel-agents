# ---- LLM ----
# mock      = deterministic scripted LLM, zero API keys needed (default)
# openai    = any OpenAI-compatible endpoint (OpenAI, Azure, vLLM, Ollama, LM Studio...)
LLM_PROVIDER=mock
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
LLM_MODEL_LARGE=mock-large
LLM_MODEL_SMALL=mock-small
MOCK_LLM_LATENCY_MS=0

# ---- Embeddings ----
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small

# ---- Governance / cost & latency control ----
AUTO_APPROVE=false
MAX_LLM_CALLS_PER_RUN=24
MAX_TOTAL_TOKENS_PER_RUN=60000
RUN_DEADLINE_MS=20000

# ---- API ----
# when set, all endpoints (except /healthz) require header X-API-Key
API_KEY=

# ---- Databricks (optional: swap local simulators for real services) ----
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_VECTOR_ENDPOINT=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CATALOG=media_intel
DATABRICKS_SCHEMA=default

# ---- Observability ----
MLFLOW_ENABLED=false
MLFLOW_TRACKING_URI=
